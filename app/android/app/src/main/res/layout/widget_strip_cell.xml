<?xml version="1.0" encoding="utf-8"?>
<!--
  本周条的**一格**。七格共用这一张（每格一个独立的 RemoteViews 实例，id 重复没关系）。

  ⚠️ 根布局的 layout_height 必须是 match_parent 而不是 wrap_content：它被塞进
  FrameLayout 槽位，拿的是槽位的 LayoutParams，自己再声明 match_parent 才与外层一致
  （v0.8.6 Task 1 真机验过这条链）。

  三行：周几 / 日数字 / 班次胶囊。高度预算见 spec §5.1：卡内可用约 62dp，
  三行 15+20+18 + 间距 4 ≈ 57dp —— **余量只有 5dp**，真机出图若被裁，
  退到「周几与日期同行」的两行备选（`一 19`），不要靠缩字号硬塞。

  没班次（空白表方案）时渲染侧把 `wg_sc_pill` 与 `wg_sc_abbr` 都设 GONE（不画胶囊，
  与 App 日历格一致）。外层那个 FrameLayout **没有 id**（渲染侧不会动它）、
  高度写死 **18dp**，因此塌不掉、那 18dp + 3dp 仍然占着 —— 这是有意的：
  一周七列高度因此恒定，不随有班/没班跳动。（宽度 2026-10-16 改成 `wrap_content`：
  没班次时它塌成 0 宽无所谓，高度那一维才是这条不变量守的东西。）

  2026-10-16（与月历同步）：`wg_sc_block` 从**实心主色块**换成**半透明玻璃块**
  （`WidgetChip.glassBlock`，与月历那格同参数）；周标题改单字；块上字改中性色。
  两张卡摆在同一屏上，这三处不一致就会露馅。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_sc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wg_sc_block"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/wg_sc_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/wg_sc_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="15dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginTop="3dp">

            <!-- ⚠️ **文字的宽度才是驱动者，位图贴上去**（与 `widget_month_cell.xml`
                 同一条，2026-10-16）。位图宽度由渲染侧 `chipWidthPx` 按简称现量。
                 **高度留 18dp 固定**（不是 wrap_content）：没班次那两行会被设成 GONE，
                 高度若跟着塌掉，一周七列的高度就会随有班/没班跳动 —— 那是这份布局
                 开头那条注释刻意守住的。
                 三个属性缺一不可：`wrap_content` 让 TextView 驱动宽度、
                 `layout_gravity="center"` 让它在（可能略宽的）位图里居中、
                 `paddingHorizontal="4dp"` 与 Kotlin 侧那 4dp 对齐。 -->
            <ImageView
                android:id="@+id/wg_sc_pill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/wg_sc_abbr"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:paddingHorizontal="4dp"
                android:gravity="center"
                android:textSize="10dp"
                android:maxLines="1" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
