<?xml version="1.0" encoding="utf-8"?>
<!--
  跟随系统（2026-11-09）：卡片底的「跟随系统」档。
  同一资源名在 `drawable-night/` 还有一份，宿主重新应用 RemoteViews 时按**当时的**
  uiMode 解析 —— 这一条正是本轮要实测的：小米桌面切深浅色时会不会重新应用。
  与 `widget_card_light.xml` 内容相同，只是多了一个限定符版本。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="22dp" />
    <gradient
        android:angle="315"
        android:startColor="@color/wg_card_from_light"
        android:endColor="@color/wg_card_to_light" />
    <stroke
        android:width="1dp"
        android:color="@color/wg_border_light" />
</shape>
