{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/onboard.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/verify-done.sh\" --full",
            "timeout": 300
          },
          {
            "type": "command",
            "if": "Bash(git tag*)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/consolidate-memory.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
